      "pub fn manacher(s: &Vec<char>) -> Vec<usize> {",
      "    let n = s.len();",
      "    let mut r = vec![0; n];",
      "    let mut i = 0;",
      "    let mut j = 0;",
      "    while i < n {",
      "        while i >= j && i + j < n && s[i - j] == s[i + j] {",
      "            j += 1;",
      "        }",
      "        r[i] = j;",
      "        let mut k = 1;",
      "        while i >= k && k + r[i - k] < j {",
