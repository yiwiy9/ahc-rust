      "        return Vec::new();",
      "    }",
      "    let h = field.len();",
      "    let w = field[0].len();",
      "    let mut dist = vec![vec![inf; w]; h];",
      "    let mut que = std::collections::VecDeque::new();",
      "    dist[s.0][s.1] = 0;",
      "    que.push_back(s);",
      "    while let Some((x, y)) = que.pop_front() {",
      "        for dir in 0..4 {",
      "            let nx = x as i32 + dx[dir];",
      "            let ny = y as i32 + dy[dir];",
      "            if nx < 0 || h as i32 <= nx || ny < 0 || w as i32 <= ny {",
      "                continue;",
      "            }",
      "            let nx = nx as usize;",
      "            let ny = ny as usize;",
      "            if field[nx][ny] == '#' {",
      "                continue;",
      "            }",
      "            if dist[nx][ny] != inf {",
      "                continue;",
      "            }",
      "            dist[nx][ny] = dist[x][y] + 1;",
      "            que.push_back((nx, ny))",
      "        }",
      "    }",
      "    dist",
      "}"
    ]
