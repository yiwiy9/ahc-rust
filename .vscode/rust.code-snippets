    "body": [
      "/// 素因数分解（素朴版）",
      "/// `2..=√n` を全探索して試し割りする。",
      "/// 実装は簡単だが、入力が大きい＆回数が多いと重くなりやすい。",
      "/// ## 計算量",
      "/// - `O(√n)`",
      "pub fn prime_factors(mut n: usize) -> Vec<(usize, usize)> {",
      "    let mut factors: Vec<(usize, usize)> = Vec::new();",
      "    for i in 2..=((n as f64).sqrt() as usize) {",
      "        if n % i != 0 {",
      "            continue;",
      "        }",
      "        let mut count = 0;",
      "        while n % i == 0 {",
      "            count += 1;",
      "            n /= i;",
      "        }",
      "        factors.push((i, count));",
      "    }",
      "    if n != 1 {",
      "        factors.push((n, 1));",
      "    }",
      "    factors",
      "}"
    ]
  },
