      "pub fn grid_bfs(field: &Vec<Vec<char>>, s: (usize, usize)) -> Vec<Vec<usize>> {",
      "    let inf: usize = 1 << 30;",
      "    let dx: [i32; 4] = [1, 0, -1, 0];",
      "    let dy: [i32; 4] = [0, 1, 0, -1];",
